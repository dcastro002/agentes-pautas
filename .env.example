# --- Claude (API de Anthropic, pago por uso) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=sonnet
MAX_USD_POR_EJECUCION=5
MAX_CONCURRENCIA=2

# --- Seguridad ---
# 1 = lee Meta de verdad pero NO crea ni cambia nada en Meta. Pásalo a 0 cuando la prueba salga bien.
MODO_PRUEBA=1
# Token largo y aleatorio para ver la oficina y los archivos: /oficina?token=...
OFICINA_TOKEN=

# --- Slack (app creada con slack_manifest.yml) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_CANAL_AVISOS=
SLACK_RESPONSABLE_EMAIL=
# IDs de Slack que pueden presionar "Aprobar", separados por coma. Vacío = cualquiera en el hilo.
SLACK_APROBADORES=

# --- Meta (token de usuario de sistema con ads_management y ads_read) ---
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
META_CUENTAS_PERMITIDAS=603185293355269
META_PAGINAS_PERMITIDAS=709010129143048

# --- Monday (token de un usuario de servicio) ---
MONDAY_API_TOKEN=
MONDAY_TABLEROS_PERMITIDOS=18434029216
MONDAY_COLUMNA_ESTATUS=color_mm7vt5cg
MONDAY_ESTATUS_DISPARO=Listo para montar
MONDAY_COLUMNA_SOLICITANTE=multiple_person_mm7vwycn
# Parte secreta de la URL del webhook: /webhooks/monday/<este valor>
MONDAY_WEBHOOK_SECRET=

# --- Web ---
# Dominio público de Railway, ej. https://agentes-pauta-production.up.railway.app
PUBLIC_URL=
# En Railway: monta un volumen en /data. Si no defines DATABASE_URL se usa SQLite en el volumen.
DATABASE_URL=
