# --- Claude (API de Anthropic, pago por uso) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=sonnet
MAX_USD_POR_EJECUCION=5
MAX_CONCURRENCIA=2

# --- Seguridad ---
# 1 = lee Meta de verdad pero NO crea ni cambia nada en Meta. Pásalo a 0 cuando la prueba salga bien.
MODO_PRUEBA=1
# Token largo y aleatorio para ver la oficina y los archivos: /oficina?token=...
OFICINA_TOKEN=

# --- Slack (app creada con slack_manifest.yml) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_CANAL_AVISOS=
SLACK_RESPONSABLE_EMAIL=
# IDs de Slack que pueden presionar "Aprobar", separados por coma. Vacío = cualquiera en el hilo.
SLACK_APROBADORES=

# --- Meta (token de usuario de sistema con ads_management y ads_read) ---
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
META_CUENTAS_PERMITIDAS=603185293355269
META_PAGINAS_PERMITIDAS=709010129143048

# --- Google Ads (cliente OAuth "App de escritorio" en el proyecto de Google Cloud) ---
# El refresh token se genera una vez con: python3 scripts/google_refresh_token.py
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC de Freelan y cuentas que el agente puede tocar, sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUENTAS_PERMITIDAS=3701698329
GOOGLE_ADS_API_VERSION=v26
# Tope de seguridad: presupuesto diario máximo por campaña (MXN). 0 = sin tope.
GOOGLE_ADS_PRESUPUESTO_MAX_DIARIO=500
GOOGLE_ADS_MONEDA=MXN
# Opcional: ya no hace falta desde sep-2026 (el acceso vive en el proyecto de Cloud)
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- LinkedIn Ads (app con el producto Advertising API aprobado) ---
# Token de acceso del portal de desarrolladores (Auth → OAuth 2.0 tools), con r_ads, rw_ads, r_ads_reporting
# y w_organization_social. Dura 60 días. Si LinkedIn da refresh token, llena también las 3 de abajo.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CUENTAS_PERMITIDAS=519998414
LINKEDIN_API_VERSION=202610
LINKEDIN_PRESUPUESTO_MAX_DIARIO=500
LINKEDIN_MONEDA=MXN

# Hosts de los que el servidor puede descargar imágenes para Meta y LinkedIn (public_url de Monday)
HOSTS_IMAGENES=monday.com,files-monday-com.s3.amazonaws.com

# --- Monday (token de un usuario de servicio) ---
MONDAY_API_TOKEN=
MONDAY_TABLEROS_PERMITIDOS=18434029216
MONDAY_COLUMNA_ESTATUS=color_mm7vt5cg
MONDAY_ESTATUS_DISPARO=Listo para montar
MONDAY_COLUMNA_SOLICITANTE=multiple_person_mm7vwycn
MONDAY_COLUMNA_NOTAS=long_text_mm7vmg76
# Estatus que mandan DM a quien creó el elemento y a su Solicitante (con las Notas del agente)
MONDAY_ESTATUS_AVISO=Error,Falta info
# 1 = avisar a SLACK_RESPONSABLE_EMAIL cuando alguien crea un elemento a mano en el tablero
AVISAR_ELEMENTO_NUEVO=1
# Parte secreta de la URL del webhook: /webhooks/monday/<este valor>
MONDAY_WEBHOOK_SECRET=

# --- Web ---
# Dominio público de Railway, ej. https://agentes-pauta-production.up.railway.app
PUBLIC_URL=
# En Railway: monta un volumen en /data. Si no defines DATABASE_URL se usa SQLite en el volumen.
DATABASE_URL=
